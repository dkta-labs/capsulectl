{
  "schema": 1,
  "sourceURI": "https://github.com/dkta-labs/capsulectl/tree/main/images/npm-resolver",
  "source": "..",
  "workdir": "/workspace",
  "network": "none",
  "command": [
    "npm",
    "--version"
  ],
  "minimumReleaseAgeDays": 3,
  "denyFeeds": [
    "https://socket.dev/api/public/supply-chain-attacks/keyv-and-cacheable-compromise/packages.csv"
  ],
  "intake": {
    "dockerfile": "Dockerfile",
    "inputs": [
      "package.json",
      "package-lock.json"
    ],
    "lockfile": "package-lock.json"
  }
}
